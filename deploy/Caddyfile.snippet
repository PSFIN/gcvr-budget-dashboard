
# budget.choosegulfcoast.com — static dashboard, no login.
# Append to the BOTTOM of /etc/caddy/Caddyfile and /etc/caddy/Caddyfile.pending.
# Never edit the other site blocks.
# X-Robots-Tag asks search engines not to list the page. It is not access control:
# anyone who has the address can open it.
budget.choosegulfcoast.com {
	root * /var/www/budget
	encode gzip
	header Cache-Control "no-cache"
	header X-Robots-Tag "noindex, nofollow"
	file_server
}
